{
	"name": "seven-seed-dashboard",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "nk lint",
		"format": "nk format",
		"type-check": "nk type-check",
		"typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput --project tsconfig.watch.json",
		"ci": "nk check && nk type-check",
		"check": "nk check",
		"prepare": "git config core.hooksPath .githooks || true"
	},
	"dependencies": {
		"@headlessui/react": "^2.2.10",
		"@heroicons/react": "^2.2.0",
		"@ingram-tech/nk-email": "^0.6.2",
		"@ingram-tech/nk-forms": "^0.3.1",
		"@ingram-tech/nk-seo": "^0.10.1",
		"clsx": "^2.1.1",
		"next": "^16.3.3",
		"postcss": "^8.5.26",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"zod": "^4.5.4"
	},
	"knip": {
		"rules": {
			"exports": "off",
			"types": "off",
			"nsExports": "off",
			"nsTypes": "off",
			"enumMembers": "off",
			"duplicates": "off"
		}
	},
	"devDependencies": {
		"@ingram-tech/nk-dev": "^0.13.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@types/node": "^26.4.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "^19.2.5",
		"knip": "^6.33.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2"
	}
